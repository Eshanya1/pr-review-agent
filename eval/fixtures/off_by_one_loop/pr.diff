+def chunk_ids(ids: list[int], batch_size: int):
+    batches = []
+    for i in range(0, len(ids), batch_size):
+        batches.append(ids[i:i + batch_size])
+    return batches
+
+
+def last_n_days(days: int):
+    result = []
+    for i in range(1, days):
+        result.append(i)
+    return result
