--- /dev/null
+++ b/app/api/pagination.py
@@ -0,0 +1,8 @@
+def paginate(items, page: int, page_size: int = 20):
+    start = page * page_size
+    end = start + page_size
+    return items[start:end + 1]
+
+
+def get_page_count(total_items: int, page_size: int = 20):
+    return total_items // page_size
