+from datetime import datetime
+
+
+def is_invoice_overdue(due_date: datetime) -> bool:
+    return datetime.now() > due_date
+
+
+def days_until_due(due_date: datetime) -> int:
+    delta = due_date - datetime.now()
+    return delta.days
